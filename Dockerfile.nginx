# ./Dockerfile.nginx
# Стадия 1: Сборка фронтенда
FROM node:18-alpine AS frontend-builder

WORKDIR /app

# Копируем файлы зависимостей
COPY ./frontend/package*.json ./

# Устанавливаем зависимости и ОБЯЗАТЕЛЬНО устанавливаем rollup явно
RUN npm ci && npm install rollup@3.29.4 --save-dev

# Копируем весь исходный код фронтенда
COPY ./frontend/ .

# Собираем фронтенд
RUN npm run build

# Стадия 2: Финальный образ с nginx
FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf
COPY ./nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-builder /app/dist /usr/share/nginx/html